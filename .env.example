# Modo simples (site estático, ex: Netlify):
# 1) Renomeie este arquivo para  .env
# 2) Cole sua chave do Gemini na linha abaixo
# 3) Rode: npm run build
# A chave fica embutida no site e serve TODOS os usuários — ninguém
# precisa colar chave nenhuma, e não precisa de servidor.

GEMINI_API_KEY=cole_sua_chave_aqui
